{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": { "type": "number" },
      "conceito": { "type": "string" },
      "dica": { "type": "string" },
      "mapa": {
        "type": "array",
        "items": {
          "type": "array",
          "items": { "type": "number" }
        }
      },
      "startPos": {
        "type": "object",
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" },
          "dir": { "type": "number" }
        },
        "required": ["x", "y", "dir"]
      },
      "chips": { "type": "number" }
    },
    "required": ["id", "conceito", "dica", "mapa", "startPos", "chips"]
  }
}
